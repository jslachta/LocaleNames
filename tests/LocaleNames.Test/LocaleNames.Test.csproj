<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<CollectCoverage>true</CollectCoverage>
		<ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
		<CoverletOutputFormat>lcov</CoverletOutputFormat>
	</PropertyGroup>
	<Import Project="..\..\targets\Configuration.targets" />
	<PropertyGroup>
		<CoverletOutput>$(RepoRoot)/out/coverage/lcov.info</CoverletOutput>
	 </PropertyGroup>
	<ItemGroup>
		<!-- Marks this assembly like the ones with embedded locales, to cover the lookup of marked assemblies. -->
		<AssemblyMetadata Include="LocaleNames.Resources" Value="true" />
		<!-- A locale resource of this assembly, so it can be registered like the ones with embedded locales. -->
		<EmbeddedResource Include="Resources\language.qq.sample.lnb" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\src\LocaleNames\LocaleNames.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="coverlet.msbuild" Version="10.1.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
		<PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
		<PackageReference Include="coverlet.collector" Version="10.1.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403" />
	</ItemGroup>
</Project>

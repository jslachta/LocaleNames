<Project Sdk="Microsoft.NET.Sdk">
	<!-- Meta package: contains no code, only references LocaleNames.Core and LocaleNames.Data. -->
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
		<PackageId>LocaleNames</PackageId>
		<Description>Localized names of languages, countries and currencies for .NET, with lookup in both directions. Powered by Unicode CLDR.</Description>
	</PropertyGroup>

	<Import Project="..\..\targets\Configuration.targets" />

	<PropertyGroup>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IncludeSymbols>false</IncludeSymbols>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\LocaleNames.Core\LocaleNames.Core.csproj" />
		<!-- PrivateAssets none: the build props of the data package (it roots the assembly for trimming and native AOT) have to reach the consumer. -->
		<ProjectReference Include="..\LocaleNames.Data\LocaleNames.Data.csproj" PrivateAssets="none" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403" />
	</ItemGroup>
</Project>

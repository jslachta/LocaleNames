<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<PackageId>LocaleNames.Data</PackageId>
		<Description>Unicode CLDR data (names of languages, countries and currencies) for the LocaleNames library, embedded in an assembly. Set LocaleNamesLocales to embed only selected locales into your own assembly instead.</Description>
	</PropertyGroup>

	<Import Project="..\..\targets\Configuration.targets" />

	<PropertyGroup>
		<!-- Resources only, there is no code to document. -->
		<GenerateDocumentationFile>false</GenerateDocumentationFile>

		<!-- The data comes from Unicode CLDR and stays under its licence, the build files are under the licence of the repository. -->
		<PackageLicenseExpression>MIT AND Unicode-3.0</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\language.*.lnb" />

		<!-- Raw copy of the same files, embedded into the consuming assembly when it selects locales (LocaleNamesLocales). -->
		<None Include="Resources\language.*.lnb" Pack="true" PackagePath="resources" Visible="false" />

		<None Include="build\**" Pack="true" PackagePath="build" />

		<None Include="..\..\LICENSE-CLDR" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- A dependency of the package, so that LocaleNames.Data alone gives the code too (the assembly itself has no code). -->
		<ProjectReference Include="..\LocaleNames.Core\LocaleNames.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403" />
	</ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
		<PackageId>LocaleNames.Core</PackageId>
		<Description>Code of the LocaleNames library - lookup of localized names of languages, countries and currencies. Contains no data, reference LocaleNames.Data for it.</Description>
		<!-- Enables the trim and AOT analyzers (for the net10.0 target) and marks the assembly as trimmable and AOT compatible. -->
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
	</PropertyGroup>

	<Import Project="..\..\targets\Configuration.targets" />

	<ItemGroup>
		<InternalsVisibleTo Include="LocaleNames.Test" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403" />
	</ItemGroup>
</Project>

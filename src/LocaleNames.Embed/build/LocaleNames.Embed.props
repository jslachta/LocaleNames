<Project>
	<!-- Where the raw resource files are: in the package. Not set when this file is imported from the repository sources. -->
	<PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\resources')">
		<LocaleNamesDataDirectory Condition="'$(LocaleNamesDataDirectory)' == ''">$(MSBuildThisFileDirectory)..\resources</LocaleNamesDataDirectory>
	</PropertyGroup>

	<!--
		Marks the referencing assembly as a holder of locale resources, so LocaleNames.Core finds them.
		Needs GenerateAssemblyInfo (default); otherwise call LocaleResourceProvider.Register(assembly).
	-->
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>LocaleNames.Resources</_Parameter1>
			<_Parameter2>true</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
</Project>

<Project>
	<!-- Tells LocaleNames.Embed where the raw resource files of this package are. -->
	<PropertyGroup>
		<LocaleNamesDataDirectory Condition="'$(LocaleNamesDataDirectory)' == ''">$(MSBuildThisFileDirectory)..\resources</LocaleNamesDataDirectory>
	</PropertyGroup>

	<!--
		LocaleNames.Core finds the data assembly by its name, nothing references it from the code. Without this the
		assembly is dropped by trimming and native AOT, and all the translations are empty.
	-->
	<ItemGroup>
		<TrimmerRootAssembly Include="LocaleNames.Data" />
	</ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
		<PackageId>LocaleNames.Core</PackageId>
		<Description>Code of the LocaleNames library - lookup of localized names of languages, countries and currencies. Contains no data, reference LocaleNames.Data or LocaleNames.Embed for it.</Description>
		<!-- Enables the trim and AOT analyzers (net8.0 and newer) and marks the assembly as trimmable and AOT compatible. -->
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<Import Project="..\Configuration.targets" />
</Project>

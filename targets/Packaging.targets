<Project>
	<!-- Metadata shared by all packages produced from this repository. Import after setting PackageId. -->
	<PropertyGroup>
		<Authors>Jiri Slachta</Authors>
		<Copyright>Copyright © Jiri Slachta</Copyright>
		<PackageTags>locale;localization;translations;cldr;country;language;currency</PackageTags>

		<PackageReleaseNotes>Check: https://github.com/jslachta/LocaleNames/releases </PackageReleaseNotes>
		<PackageProjectUrl>https://github.com/jslachta/LocaleNames</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jslachta/LocaleNames</RepositoryUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>

		<PackageLicenseExpression>Unlicense</PackageLicenseExpression>

		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>

		<LangVersion>10.0</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="True" PackagePath="\" Link="Properties\README.md" />
	</ItemGroup>
</Project>

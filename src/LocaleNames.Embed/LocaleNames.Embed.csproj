<Project Sdk="Microsoft.NET.Sdk">
	<!-- Build-only package: no assembly. Referencing it embeds the LocaleNames.Data resources into the referencing assembly. -->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<PackageId>LocaleNames.Embed</PackageId>
		<Description>Embeds the LocaleNames CLDR data (names of languages, countries and currencies) directly into your assembly at build time, optionally only for selected locales.</Description>
	</PropertyGroup>

	<Import Project="..\..\targets\Configuration.targets" />

	<PropertyGroup>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IncludeSymbols>false</IncludeSymbols>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="build\**" Pack="true" PackagePath="build" />

		<!-- The data embedded into the consuming assembly, the same files LocaleNames.Data embeds into its own one. -->
		<None Include="..\LocaleNames.Data\Resources\language.*.lnb" Pack="true" PackagePath="resources" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LocaleNames.Core\LocaleNames.Core.csproj" />
	</ItemGroup>
</Project>
